# =============================================================================
# Demucster — Environment Configuration
# =============================================================================
# Copy to .env and customise. All values below are defaults.

# --- Model Settings ----------------------------------------------------------
# Best-to-fastest: htdemucs_ft > htdemucs > htdemucs_6s > mdx_extra > mdx_extra_q > mdx
DEFAULT_MODEL=htdemucs_ft

# --- Output Settings ---------------------------------------------------------
OUTPUT_FORMAT=mp3          # mp3 | wav
MP3_BITRATE=320            # 128 – 320 kbps

# --- GPU / Worker Settings ---------------------------------------------------
MAX_CONCURRENT_JOBS=2      # Bounded by GPU VRAM; GB10 128 GB allows more
DEVICE=cuda                # cpu | cuda | cuda:<index>
REQUIRE_CUDA=true          # Fail startup if CUDA is unavailable
# SEGMENT_SIZE=8           # Positive integer seconds. Lower = less GPU memory.

# --- Storage Settings --------------------------------------------------------
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
MAX_FILE_SIZE_MB=500       # Max upload size in megabytes
RETENTION_HOURS=24         # Purge outputs older than this

# --- Server Settings ---------------------------------------------------------
PREWARM_MODEL=true         # Pre-load default model on startup
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
MAX_DOWNLOAD_DURATION=3600 # Max yt-dlp download duration in seconds (1 hour)

# --- Lyrics Extraction & Ollama ----------------------------------------------
LYRICS_ENABLED=true
LYRICS_DIR=/data/lyrics
WHISPER_CACHE_DIR=/data/model-cache/whisper
LYRICS_DEFAULT_MODEL=large-v3-turbo
LYRICS_MAX_CONCURRENT_JOBS=1
LYRICS_PREWARM_MODEL=false
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:27b
OLLAMA_TIMEOUT_SECONDS=120
